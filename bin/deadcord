#!/usr/bin/env bash
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ ${SOURCE:0:1} != "/" ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

EXEC_FLAGS=(
    --enable-features=UseOzonePlatform,WebRTCPipeWireCapturer,AcceleratedVideoDecoder,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,VaapiVideoDecoder,VaapiVideoDecodeLinuxGL
    --disable-features=WaylandWpColorManagerV1,HardwareMediaKeyHandling,MediaSessionService,Vulkan
    --ozone-platform=wayland
    --ignore-gpu-blocklist
    --enable-gpu-rasterization
    --enable-zero-copy
    --disable-breakpad
    --disable-component-update
)

exec electron43 "${EXEC_FLAGS[@]}" "$DIR" "$@"
