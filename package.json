    "anonymity",
    "fail-closed",
    "kill-switch",
    "anti-fingerprint",
    "multi-account",
    "anti-tracking",
    "wayland",
    "exif-cleaner",
    "security",
    "electron"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deadcow-ghw/Deadcord.git"
  },
  "bugs": {
    "url": "https://github.com/deadcow-ghw/Deadcord/issues"
  },
  "homepage": "https://github.com/deadcow-ghw/Deadcord#readme",
  "scripts": {
    "start": "electron43 . --enable-features=UseOzonePlatform,WebRTCPipeWireCapturer --ozone-platform=wayland",
